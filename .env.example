# Local development defaults only; keep .env out of source control.
ENVIRONMENT=development
# Development-only placeholder. Set a unique secret before deployment.
SESSION_SECRET=development-only-change-this-secret
DATABASE_PATH=data/careloop.sqlite3
ENABLE_DEMO_ACCOUNTS=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
BREVO_API_KEY=
SENDER_EMAIL=
